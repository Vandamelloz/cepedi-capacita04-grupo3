# Exemplo de arquivo de configuração do banco de dados (Variáveis de Ambiente)
# Copie este arquivo, renomeie para .env e preencha com suas credenciais locais.

host=localhost
user=root
password=sua_senha_do_banco_aqui
database=gipar_db

# ==========================================
# Configurações de E-mail (SMTP)
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_aplicativo
